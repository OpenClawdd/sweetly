    "@tanstack/virtual-core": "^3.17.6",
    "cubic-spline": "^3.0.3",
    "cyrillic-romanization": "^1.2.2",
    "d3-ease": "^3.0.1",
    "electron-store": "10",
    "franc-all": "^7.2.0",
    "fuse.js": "^7.0.0",
    "idb": "^8.0.3",
    "kuroshiro": "^1.2.0",
    "langs": "^2.0.0",
    "nanostores": "^1.4.1",
    "semver": "^7.8.5",
