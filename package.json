  "description": "Apple Music live-synced lyrics overlay (floating + fullscreen).",
  "main": "./build/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "ELECTRON_DISABLE_SANDBOX=1 electron-vite dev",
